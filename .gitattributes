# Автоматически нормализовать окончания строк для всех текстовых файлов (приведение к LF в репозитории)
* text=auto

# Явное указание кодировки для исходного кода C# и конфигураций
*.cs text diff=csharp
*.xaml text
*.json text
*.yaml text
*.md text

# Инициализация Git LFS для хранения тяжелых графических артефактов и документации (архитектурные схемы из ПР2 и ПР7)
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
